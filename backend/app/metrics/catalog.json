{
  "metrics": [
    {
      "metric_id": "total_delivery_count",
      "name_zh": "总交车量",
      "name_en": "Total Delivery Count",
      "description": "按 statistics_date 统计的已完成交付订单量。",
      "table": "fact_delivery_orders",
      "time_field": "statistics_date",
      "aggregation": {
        "type": "count_distinct",
        "field": "order_id"
      },
      "default_filters": {
        "order_status": "completed"
      },
      "allowed_dimensions": [
        "channel",
        "region_group",
        "region",
        "city",
        "store_name",
        "sales_person_name",
        "business_type",
        "statistics_date"
      ],
      "formula": "COUNT(DISTINCT order_id)",
      "owner": "BI Team",
      "update_frequency": "daily",
      "aliases": [
        "交车",
        "交车量",
        "交付",
        "交付量"
      ]
    },
